TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Hosted TypeSafe by default. Two local servers speak the same /v1/systemone protocol;
# pick one and set the matching profile. See "Self-hosted decision models" in README.md.
#   laya (recommended):  TYPESAFE_PROFILE=laya    -> TYPESAFE_BASE_URL=http://127.0.0.1:8000
#   jeff:               TYPESAFE_PROFILE=jeff    -> TYPESAFE_BASE_URL=http://127.0.0.1:8000
# The profile sets coherent budgets; each is an independent override, and 0 means "no limit".
# TYPESAFE_ELEMENT_BUDGET=8
# TYPESAFE_OPTION_BUDGET=2
# TYPESAFE_STATE_CHARS=800
# TYPESAFE_RULES=terse
# TYPESAFE_MODEL=typed-decisions
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
